<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>I love you ❤</title>
<style>
  html, body {
    margin: 0;
    padding: 0;
    background: #000;
    overflow: hidden;
    height: 100%;
  }
  canvas {
    display: block;
    margin: 0 auto;
  }
</style>
</head>
<body>
<canvas id="heart"></canvas>

<script>
  const canvas = document.getElementById('heart');
  const ctx = canvas.getContext('2d');

  const W = window.innerWidth;
  const H = window.innerHeight;
  canvas.width = W;
  canvas.height = H;

  const cx = W / 2;
  const cy = H / 2;

  const tau = Math.PI * 2;
  const steps = 120;

  ctx.fillStyle = '#ffb6c1';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.font = '8px Arial, sans-serif';

  const baseScale = Math.min(W, H) / 40;

  // Собираем все точки заранее (в том же порядке, что и в Python-коде)
  const points = [];
  for (let scale = 11; scale < 17; scale++) {
    const s = scale * baseScale / 16;
    for (let i = 0; i < steps; i++) {
      const t = i * tau / steps;
      const x = 16 * Math.pow(Math.sin(t), 3);
      const y = (13 * Math.cos(t)
                - 5 * Math.cos(2 * t)
                - 2 * Math.cos(3 * t)
                - Math.cos(4 * t));
      points.push({
        px: cx + x * s,
        py: cy - y * s
      });
    }
  }

  // Плавно рисуем точки по одной
  let index = 0;
  const delay = 8; // миллисекунд между точками (меньше = быстрее)

  function drawNext() {
    if (index >= points.length) return;

    const p = points[index++];
    ctx.fillText('I love you', p.px, p.py);

    setTimeout(drawNext, delay);
  }

  drawNext();
</script>
</body>
</html>
